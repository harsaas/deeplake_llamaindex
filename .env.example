# If you use Deep Lake Cloud (hub://...), you may need to set tokens/keys.
# Copy to .env and fill in.

# For OpenAI embeddings (default LlamaIndex embedding model in this setup):
# OPENAI_API_KEY=...

# DeepLake dataset path examples:
# DEEPLAKE_DATASET_PATH=hub://your_org/your_dataset
# DEEPLAKE_DATASET_PATH=mem://llamaindex_intro

# Optional: Activeloop/Deep Lake token (if required by your DeepLake setup)
# ACTIVELOOP_TOKEN=...
