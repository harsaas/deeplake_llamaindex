# If you use Deep Lake Cloud (hub://...), you may need to set tokens/keys.
# Copy to .env and fill in.

# For OpenAI embeddings (default LlamaIndex embedding model in this setup):
# OPENAI_API_KEY=...

# GitHub repository to ingest (HTTPS URL)
# GITHUB_REPO_URL=https://github.com/<owner>/<repo>

# GitHub Personal Access Token (classic or fine-grained)
# Prefer GITHUB_TOKEN; GIT_HUB_TOKEN is accepted for backward compatibility.
# GITHUB_TOKEN=...
# GIT_HUB_TOKEN=...

# Optional: branch name. If omitted, scripts will auto-detect the repo default branch.
# GITHUB_BRANCH=main

# DeepLake dataset path examples:
# DEEPLAKE_DATASET_PATH=hub://your_org/your_dataset
# DEEPLAKE_DATASET_PATH=mem://llamaindex_intro

# Optional: Activeloop/Deep Lake token (if required by your DeepLake setup)
# ACTIVELOOP_TOKEN=...
